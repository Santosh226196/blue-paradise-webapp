# App
VITE_APP_NAME="Blue Paradise Water Club"
VITE_APP_VERSION="1.0.0"

# API (server origin only — /api prefix is added automatically)
# Dev uses the Vite proxy, so leave blank. For production set the server URL, e.g. https://your-domain.com
VITE_API_BASE_URL=""

# Auth
VITE_JWT_SECRET=
VITE_SESSION_TIMEOUT="86400"

# Features
VITE_ENABLE_PRINTER="true"
VITE_ENABLE_NOTIFICATIONS="true"
VITE_ENABLE_OFFLINE="true"

# Club
VITE_DEFAULT_OPEN_TIME="05:00"
VITE_DEFAULT_CLOSE_TIME="22:00"
